msgstr ""
"Sadraey, M. H. (2020). Design of Unmanned Aerial Systems. "
"John Wiley & Sons. ISBN 978-1-119-50862-5."

msgid "section.appendix_references.ref.keane"
msgstr ""
"Keane, A. J., Sóbester, A., & Scanlan, J. P. (2017). Small Unmanned "
"Fixed-Wing Aircraft Design: A Practical Approach. Wiley."

msgid "section.appendix_references.ref.dsto"
msgstr ""
"DSTO ADA623605 — UAS database of geometric and performance "
