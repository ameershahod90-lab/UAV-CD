msgid "section.constraint_equations.title"
msgstr "تحليل القيود — المعادلات"

msgid "section.constraint_equations.intro"
msgstr ""
"تُشتَقّ قيود الأداء الخمسة كدوالّ في حمل الجناح $${W/S}$$ وتُرسَم على مخطط "
"المطابقة. أرقام المعادلات بين قوسين هي مراجع داخلية لهذا التقرير."

msgid "section.constraint_equations.intro.with_refs"
msgstr ""
"تُشتَقّ قيود الأداء الخمسة كدوالّ في حمل الجناح $${W/S}$$ وتُرسَم على مخطط "
"المطابقة. أرقام المعادلات بين قوسين هي مراجع داخلية لهذا التقرير؛ الاشتقاقات "
"الأصلية تتبع Sadraey 2020، القسم 2.9 (المعادلات 2.38-2.46 لحدود القيود، "
"والمعادلات 2.49-2.51 لحساب الجناح والمحرك)."

msgid "section.constraint_equations.heading.stall"
msgstr "1. قيد سرعة الانهيار"

msgid "section.constraint_equations.heading.max_speed"
msgstr "2. السرعة الأفقية القصوى"

msgid "section.constraint_equations.heading.takeoff"
